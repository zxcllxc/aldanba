// Generates narration mp3 for every line (both languages) with edge-tts.
// Usage: npx tsx scripts/tts.mts   (needs: python -m pip install edge-tts)
import { execFile } from "node:child_process";
import { existsSync, mkdirSync, readdirSync, unlinkSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { promisify } from "node:util";
import { LESSONS } from "../src/content";
import { audioKey } from "../src/lib/audio-key";

const run = promisify(execFile);
const OUT = join(import.meta.dirname, "..", "public", "audio");
const VOICES: Record<string, Record<string, string[]>> = {
  kk: {
    n: ["--voice", "kk-KZ-AigulNeural", "--rate=-8%"],
    s: ["--voice", "kk-KZ-DauletNeural", "--rate=+5%"],
    v: ["--voice", "kk-KZ-AigulNeural", "--pitch=+25Hz"],
  },
  ru: {
    n: ["--voice", "ru-RU-SvetlanaNeural", "--rate=-8%"],
    s: ["--voice", "ru-RU-DmitryNeural", "--rate=+5%"],
    v: ["--voice", "ru-RU-SvetlanaNeural", "--pitch=+25Hz"],
  },
};

type Job = { lang: "kk" | "ru"; voice: string; text: string };
const jobs = new Map<string, Job>();
for (const lang of ["kk", "ru"] as const) {
  for (const l of LESSONS) {
    for (const b of l.beats) {
      const voice = b.voice ?? "n";
      jobs.set(audioKey(lang, voice, b.say[lang]), { lang, voice, text: b.say[lang] });
    }
    for (const q of [...l.quiz, l.final]) {
      jobs.set(audioKey(lang, "n", q.q[lang]), { lang, voice: "n", text: q.q[lang] });
      jobs.set(audioKey(lang, "n", q.explain[lang]), { lang, voice: "n", text: q.explain[lang] });
    }
  }
}

mkdirSync(OUT, { recursive: true });
const todo = [...jobs].filter(([k]) => !existsSync(join(OUT, `${k}.mp3`)));
console.log(`lines: ${jobs.size}, to generate: ${todo.length}`);

let failed = 0;
async function worker() {
  while (todo.length) {
    const [key, j] = todo.shift()!;
    const file = join(OUT, `${key}.mp3`);
    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        await run("python", ["-m", "edge_tts", ...VOICES[j.lang][j.voice], "--text", j.text.trim(), "--write-media", file]);
        break;
      } catch (e) {
        if (attempt === 3) {
          failed++;
          console.error("FAILED", key, j.text.slice(0, 40), (e as Error).message.slice(0, 120));
        }
      }
    }
  }
}
await Promise.all(Array.from({ length: 8 }, worker));

// Remove audio for lines that no longer exist (text was edited).
let removed = 0;
for (const f of readdirSync(OUT)) {
  if (f.endsWith(".mp3") && !jobs.has(f.slice(0, -4))) {
    unlinkSync(join(OUT, f));
    removed++;
  }
}
writeFileSync(join(OUT, "README.txt"), "Generated by scripts/tts.mts — do not edit by hand.\n");
console.log(`done. failed: ${failed}, removed stale: ${removed}`);
if (failed) process.exit(1);
